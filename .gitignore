node_modules/
dist/
.vite/
*.log

# Compiler output. Regenerated by `npm run compact` locally (--skip-zk) or by
# the proving-keys workflow (with keys).
#
# The generated contract IS committed, deliberately. `ui/src/lib/market-engine.ts`
# imports it directly, so without it the UI cannot build from a fresh clone --
# and Vercel builds from a fresh clone. Nothing that builds it can run in that
# environment either: the Compact toolchain is not installed there, and this
# repo's own dev machine cannot produce keys at all (zkir needs bmi2/adx).
# 120 KB of generated JS is a cheap price for a deployable site.
#
# The build tree's copy stays out: it is ~18 MB, and everything that needs it
# reads the copy under ui/public instead. Fetch it from the proving-keys
# workflow artifact when rebuilding the contract.
contract/managed/prediction-market/keys/
contract/managed/prediction-market/zkir/

# ui/public/keys and ui/public/zkir ARE committed. They used to be ignored on
# the grounds that a proving key is inert without a proof server -- true then,
# wrong now. `#/live` proves every circuit for real, and the proof server it
# uses is the user's own, reached through Lace. `FetchZkConfigProvider` loads
# the keys from THIS origin over HTTP, so a deployment without them serves a
# live mode that cannot prove anything. 19 MB of static files is the price of
# the site working from a fresh clone, which is how Vercel builds it.

# Generated wallets. The seed in here IS the wallet -- never commit it.
wallet/.wallets/
cli/.deployments/
cli/logs/

# LevelDB store written by levelPrivateStateProvider. It holds the contract's
# private state AND the contract-maintenance signing key, encrypted with
# PRIVATE_STATE_PASSWORD -- which defaults to a constant written in deploy.ts.
# Committing it therefore publishes a signing key whose password is in the same
# repository. The path depends on the cwd the deploy ran from, so match it
# anywhere rather than at one location.
midnight-level-db/

# TypeScript incremental build cache.
*.tsbuildinfo

# Local env overrides (proof server URL etc). .env.example is committed.
.env.local
.env.*.local
