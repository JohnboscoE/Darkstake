node_modules/
dist/
.vite/
*.log

# Compiler output. Regenerated by `npm run compact` locally (--skip-zk) or by
# the proving-keys workflow (with keys).
#
# The generated contract IS committed, deliberately. `ui/src/lib/market-engine.ts`
# imports it directly, so without it the UI cannot build from a fresh clone --
# and Vercel builds from a fresh clone. Nothing that builds it can run in that
# environment either: the Compact toolchain is not installed there, and this
# repo's own dev machine cannot produce keys at all (zkir needs bmi2/adx).
# 120 KB of generated JS is a cheap price for a deployable site.
#
# The heavy, inert parts stay out. Proving keys are ~18 MB and do nothing
# without a proof server, so they are fetched from the proving-keys workflow
# artifact when they are actually needed.
contract/managed/prediction-market/keys/
contract/managed/prediction-market/zkir/

# Proving keys copied into the UI for FetchZkConfigProvider to serve.
ui/public/keys/
ui/public/zkir/

# Generated wallets. The seed in here IS the wallet -- never commit it.
wallet/.wallets/
cli/.deployments/
cli/logs/

# TypeScript incremental build cache.
*.tsbuildinfo

# Local env overrides (proof server URL etc). .env.example is committed.
.env.local
.env.*.local
